{
  "FChatSettings": {
    "ServerUrl": "wss://chat.f-list.net/chat2",
    "ClientName": "FChatBouncer",
    "ClientVersion": "1.0.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://fchat.proactiveapathy.com"
    ]
  },
  "Security": {
    "RequireHttps": false,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "PasswordMinLength": 8,
    "RequireSpecialCharacters": true,
    "RequireNumbers": true,
    "RequireUppercase": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "FChatBouncer.Server": "Information"
    }
  },
  "AllowedHosts": "*"
}