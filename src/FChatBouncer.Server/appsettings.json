{
  "FChatSettings": {
    "ServerUrl": "wss://chat.f-list.net/chat2",
    "ClientName": "FChatBouncer",
    "ClientVersion": "1.0.0"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "FChatBouncer:",
    "UseSsl": false,
    "Database": 0,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AllowAdmin": false,
    "AbortOnConnectFail": false,
    "ConnectRetry": 3,
    "KeepAlive": 60,
    "DefaultCacheExpirationMinutes": 60
  },
  "MessageQueue": {
    "Streams": {
      "RetentionPolicy": {
        "MaxMessages": 100000,
        "MaxAgeHours": 168
      },
      "ConsumerBatchSize": 100,
      "ConsumerGroupCleanupAgeHours": 720,
      "PelMaxRetries": 3,
      "PelRetryDelayMs": 5000,
      "TrimIntervalMinutes": 15
    },
    "Monitoring": {
      "EnableStreamSizeTracking": true,
      "EnableConsumerLagTracking": true,
      "CheckIntervalSeconds": 300
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://fchat.proactiveapathy.com"
    ]
  },
  "Security": {
    "RequireHttps": false,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "PasswordMinLength": 8,
    "RequireSpecialCharacters": true,
    "RequireNumbers": true,
    "RequireUppercase": true,
    "EncryptionKey": "CHANGE_THIS_IN_PRODUCTION_USE_openssl_rand_base64_32"
  },
  "AuditLog": {
    "Enabled": true,
    "RetentionDays": 90,
    "CleanupSchedule": "0 2 * * *"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error",
        "FChatBouncer.Server": "Information",
        "FChatBouncer.Server.Infrastructure": "Information",
        "FChatBouncer.Server.Redis": "Information",
        "FChatBouncer.Server.Auth": "Information",
        "FChatBouncer.Server.FChatWebSocket": "Information",
        "FChatBouncer.Server.Messaging": "Information",
        "FChatBouncer.Server.SignalR": "Information",
        "FChatBouncer.Server.Database": "Warning",
        "FChatBouncer.Server.Characters": "Information",
        "FChatBouncer.Server.Profiles": "Information",
        "FChatBouncer.Server.FListAPI": "Information",
        "FChatBouncer.Server.Security": "Information",
        "FChatBouncer.Server.Performance": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithProcessId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fchat-bouncer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [CorrelationId:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}