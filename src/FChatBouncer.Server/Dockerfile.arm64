# Alternative Dockerfile for ARM64 compatibility
# Use this if the main Dockerfile still has issues

# Use the official .NET 9.0 runtime image
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080

# Use the SDK image to build the application
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj and restore dependencies
COPY ["FChatBouncer.Server.csproj", "./"]
RUN dotnet restore "FChatBouncer.Server.csproj" --disable-parallel

# Copy the rest of the application
COPY . .

# Build the application
RUN dotnet build "FChatBouncer.Server.csproj" -c Release -o /app/build --no-restore

# Publish the application
FROM build AS publish
RUN dotnet publish "FChatBouncer.Server.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-build

# Final stage
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create a non-root user for security
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser /app
USER appuser

ENTRYPOINT ["dotnet", "FChatBouncer.Server.dll"]
